@model IEnumerable<MediTrackPro.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="doctors-container" style="background-color: #f5f9fc; min-height: 100vh; padding: 2rem 0;">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 style="color: #2c3e50; font-weight: 600;">
                    <i class="fas fa-user-md me-2" style="color: #3498db;"></i>@ViewData["Title"]
                </h1>
                <p class="text-muted">Manage medical staff and specialists</p>
            </div>
            <div class="text-end">
                <a asp-action="Create" class="btn btn-primary" style="background-color: #3498db; border: none;">
                    <i class="fas fa-plus-circle me-1"></i> Add New Doctor
                </a>
            </div>
        </div>

        <!-- Doctors Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color: #3498db; color: white;">
                            <tr>
                                <th><i class="fas fa-user-tie me-1"></i> Doctor</th>
                                <th><i class="fas fa-stethoscope me-1"></i> Specialty</th>
                                <th><i class="fas fa-phone me-1"></i> Contact</th>
                                <th class="text-end"><i class="fas fa-cog me-1"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>Dr. @item.LastName</strong><br>
                                        <small class="text-muted">@item.FirstName</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Specialty))
                                        {
                                            <span class="badge" style="background-color: #e3f2fd; color: #0d47a1;">
                                                @item.Specialty
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ContactNumber))
                                        {
                                            @item.ContactNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not provided</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom Styles -->
<style>
    .table-hover tbody tr:hover {
        background-color: rgba(52, 152, 219, 0.1);
    }

    .badge {
        padding: 0.5em 0.75em;
        font-size: 0.85em;
        border-radius: 4px;
    }
</style>  

