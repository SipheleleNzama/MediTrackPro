@model IEnumerable<MediTrackPro.Models.Patient>

@{
    ViewData["Title"] = "Patient Registry";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-semibold text-primary">
                <i class="fas fa-procedures me-2"></i>@ViewData["Title"]
            </h1>
            <p class="lead text-muted">Manage comprehensive patient records</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-user-plus me-2"></i>Register Patient
            </a>
        </div>
    </div>

    <!-- Patient Metrics -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                        <i class="fas fa-users text-primary fs-4"></i>
                    </div>
                    <h5 class="text-muted mb-2">Total Patients</h5>
                    <h2 class="text-primary">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                        <i class="fas fa-calendar-check text-success fs-4"></i>
                    </div>
                    <h5 class="text-muted mb-2">Active Cases</h5>
                    <h2 class="text-success">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="bg-info bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                        <i class="fas fa-file-medical text-info fs-4"></i>
                    </div>
                    <h5 class="text-muted mb-2">New This Month</h5>
                    <h2 class="text-info">@Model.Count()</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Patients Table -->
    <div class="card border-0 shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th><i class="fas fa-id-card me-2"></i>Patient</th>
                            <th><i class="fas fa-phone-alt me-2"></i>Contact</th>
                            <th><i class="fas fa-fingerprint me-2"></i>Identification</th>
                            <th class="text-end"><i class="fas fa-cogs me-2"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="py-3">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="fas fa-user text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@item.FirstName @item.LastName</h6>
                                            <small class="text-muted">MRN: @item.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ContactNumber))
                                    {
                                        <a href="tel:@item.ContactNumber" class="text-decoration-none">
                                            <i class="fas fa-phone-alt me-2"></i>@item.ContactNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.IDNumber))
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary py-2 px-3">
                                            <i class="fas fa-id-card me-1"></i>@item.IDNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-pen-to-square me-1"></i>Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-file-alt me-1"></i>Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table > :not(:first-child) {
        border-top: none;
    }

    tr {
        border-bottom: 1px solid #f0f0f0;
    }

        tr:last-child {
            border-bottom: none;
        }

    .btn-group .btn {
        border-radius: 0.25rem !important;
    }
</style>