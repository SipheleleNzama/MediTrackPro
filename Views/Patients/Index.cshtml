@model IEnumerable<MediTrackPro.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<div class="patients-container" style="background-color: #f5f9fc; min-height: 100vh; padding: 2rem 0;">
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 style="color: #2c3e50; font-weight: 600;">
                    <i class="fas fa-user-injured me-2" style="color: #3498db;"></i>@ViewData["Title"]
                </h1>
                <p class="text-muted">Manage patient records and information</p>
            </div>
            <div class="text-end">
                <a asp-action="Create" class="btn btn-primary" style="background-color: #3498db; border: none;">
                    <i class="fas fa-plus-circle me-1"></i> Add New Patient
                </a>
            </div>
        </div>

        <!-- Summary Card -->
        <div class="row mb-4">
            <div class="col-md-12 mb-3">
                <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #e3f2fd, #bbdefb);">
                    <div class="card-body text-center">
                        <h5 class="card-title" style="color: #0d47a1;">Total Patients</h5>
                        <h2 style="color: #1976d2;">@Model.Count()</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Patients Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color: #3498db; color: white;">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Patient</th>
                                <th><i class="fas fa-phone me-1"></i> Contact</th>
                                <th><i class="fas fa-id-card me-1"></i> ID Number</th>
                                <th class="text-end"><i class="fas fa-cog me-1"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.FirstName @item.LastName</strong><br>
                                        <small class="text-muted">ID: @item.Id</small>
                                    </td>
                                    <td>@item.ContactNumber</td>
                                    <td>@item.IDNumber</td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom Styles -->
<style>
    .table-hover tbody tr:hover {
        background-color: rgba(52, 152, 219, 0.1);
    }

    .card {
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-3px);
        }
</style>