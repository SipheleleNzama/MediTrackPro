@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-container" style="background-color: #f8f9fa; min-height: 100vh; padding: 2rem 0;">
    <div class="container">
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 style="color: #2c3e50; font-weight: 600;">@ViewData["Title"]</h1>
            <p class="lead" style="color: #3498db;">Last Updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>

        <!-- Policy Content -->
        <div class="card shadow-sm border-0" style="border-radius: 10px;">
            <div class="card-body p-4 p-md-5">
                <!-- Introduction -->
                <section class="mb-5">
                    <h2 style="color: #2980b9; border-bottom: 2px solid #ecf0f1; padding-bottom: 0.5rem;">Our Commitment</h2>
                    <p class="text-muted">
                        MediTrackPro is committed to protecting the privacy and security of your personal health information.
                        This policy outlines how we collect, use, and safeguard your data in compliance with HIPAA and other
                        applicable regulations.
                    </p>
                </section>

                <!-- Data Collection -->
                <section class="mb-5">
                    <h2 style="color: #2980b9; border-bottom: 2px solid #ecf0f1; padding-bottom: 0.5rem;">Information We Collect</h2>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex mb-3">
                                <div class="me-3" style="color: #27ae60;">
                                    <i class="fas fa-user-circle fa-2x"></i>
                                </div>
                                <div>
                                    <h5 style="color: #2c3e50;">Personal Information</h5>
                                    <p class="text-muted small">
                                        Name, contact details, date of birth, insurance information, and other identifiers.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex mb-3">
                                <div class="me-3" style="color: #27ae60;">
                                    <i class="fas fa-heartbeat fa-2x"></i>
                                </div>
                                <div>
                                    <h5 style="color: #2c3e50;">Health Data</h5>
                                    <p class="text-muted small">
                                        Medical history, treatment records, prescriptions, and test results.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Data Usage -->
                <section class="mb-5">
                    <h2 style="color: #2980b9; border-bottom: 2px solid #ecf0f1; padding-bottom: 0.5rem;">How We Use Your Information</h2>
                    <div class="alert alert-light" style="background-color: #e8f4fc; border-left: 4px solid #3498db;">
                        <p class="mb-0" style="color: #2c3e50;">
                            <i class="fas fa-info-circle me-2" style="color: #3498db;"></i>
                            Your data is used exclusively for healthcare purposes, including treatment coordination,
                            billing, and improving our services.
                        </p>
                    </div>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex align-items-center border-0 py-3">
                            <span class="badge bg-primary rounded-pill me-3">1</span>
                            Provide and manage your medical care
                        </li>
                        <li class="list-group-item d-flex align-items-center border-0 py-3">
                            <span class="badge bg-primary rounded-pill me-3">2</span>
                            Process insurance claims
                        </li>
                        <li class="list-group-item d-flex align-items-center border-0 py-3">
                            <span class="badge bg-primary rounded-pill me-3">3</span>
                            Comply with legal requirements
                        </li>
                    </ul>
                </section>

                <!-- Security -->
                <section>
                    <h2 style="color: #2980b9; border-bottom: 2px solid #ecf0f1; padding-bottom: 0.5rem;">Security Measures</h2>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="p-4 h-100" style="background-color: #eaf7ee; border-radius: 8px;">
                                <h5 style="color: #27ae60;"><i class="fas fa-shield-alt me-2"></i>Technical Safeguards</h5>
                                <p class="text-muted small mb-0">
                                    Encryption, secure servers, multi-factor authentication, and regular security audits.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="p-4 h-100" style="background-color: #e8f4fc; border-radius: 8px;">
                                <h5 style="color: #3498db;"><i class="fas fa-user-lock me-2"></i>Administrative Protections</h5>
                                <p class="text-muted small mb-0">
                                    Strict access controls, staff training, and privacy compliance officers.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Contact 
                <div class="text-center mt-5 pt-3" style="border-top: 1px solid #ecf0f1;">
                    <h4 style="color: #2c3e50;">Questions About Our Privacy Policy?</h4>
                    <a href="mailto:privacy@meditrackpro.com" class="btn btn-outline-primary mt-2">
                        <i class="fas fa-envelope me-2"></i>Contact Our Privacy Officer
                    </a>
                </div> -->
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom Style -->
<style>
    .list-group-item {
        transition: all 0.3s ease;
    }

        .list-group-item:hover {
            background-color: #f8f9fa;
            padding-left: 1.5rem;
        }

    h2 {
        font-weight: 600;
    }
</style>