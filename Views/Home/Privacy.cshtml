@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow">
                <div class="card-header bg-dark text-white py-3">
                    <h2 class="mb-0">
                        <i class="fas fa-shield-alt me-2"></i>@ViewData["Title"]
                    </h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <!-- Introduction -->
                    <section class="mb-5">
                        <h3 class="text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-lock me-2"></i>Our Commitment to Privacy
                        </h3>
                        <p class="text-muted">
                            MediTrackPro adheres to the highest standards of patient data protection in compliance with HIPAA,
                            GDPR, and other applicable healthcare privacy regulations. This policy outlines our practices
                            regarding the collection, use, and safeguarding of your health information.
                        </p>
                    </section>

                    <!-- Data Collection -->
                    <section class="mb-5">
                        <h3 class="text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-database me-2"></i>Information We Collect
                        </h3>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="d-flex">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-user-circle fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5>Personal Identifiers</h5>
                                        <p class="text-muted small">
                                            Name, date of birth, contact details, insurance information, and other identifiers.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="d-flex">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-file-medical fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5>Health Information</h5>
                                        <p class="text-muted small">
                                            Medical history, treatment records, prescriptions, and test results.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Data Protection -->
                    <section class="mb-5">
                        <h3 class="text-primary border-bottom pb-2 mb-3">
                            <i class="fas fa-lock me-2"></i>Security Measures
                        </h3>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="p-4 h-100 rounded" style="background-color: #f8f9fa;">
                                    <h5><i class="fas fa-shield-virus me-2"></i>Technical Safeguards</h5>
                                    <p class="text-muted small mb-0">
                                        Encryption, secure servers, multi-factor authentication, and regular security audits.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="p-4 h-100 rounded" style="background-color: #f8f9fa;">
                                    <h5><i class="fas fa-user-shield me-2"></i>Administrative Protections</h5>
                                    <p class="text-muted small mb-0">
                                        Strict access controls, staff training, and privacy compliance officers.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Contact -->
                    <div class="text-center mt-5 pt-4 border-top">
                        <h4 class="mb-4">Questions About Our Privacy Practices?</h4>
                        <a href="anelenzama07@gmail.com" class="btn btn-primary px-4">
                            <i class="fas fa-envelope me-2"></i>Contact Our Privacy Officer
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>