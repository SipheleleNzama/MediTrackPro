@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container" style="background-color: #f8f9fa; min-height: 100vh;">
    <div class="container py-5">
        <!-- Header -->
        <div class="dashboard-header text-center mb-5" style="color: #2c3e50;">
            <h1 class="display-4">MediTrackPro Dashboard</h1>
            <p class="lead">Quick access to your healthcare management system</p>
        </div>

        <!-- Quick Links Cards -->
        <div class="row">
            <!-- Patients Card -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #3498db, #2980b9);">
                    <div class="card-body text-white text-center">
                        <i class="fas fa-user-injured fa-3x mb-3"></i>
                        <h3 class="card-title">Patients</h3>
                        <p class="card-text">Manage patient records</p>
                        <a href="/Patients" class="btn btn-light btn-sm mt-2">Go to Patients</a>
                    </div>
                </div>
            </div>

            <!-- Appointments Card -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #2ecc71, #27ae60);">
                    <div class="card-body text-white text-center">
                        <i class="fas fa-calendar-check fa-3x mb-3"></i>
                        <h3 class="card-title">Appointments</h3>
                        <p class="card-text">Schedule and view appointments</p>
                        <a href="/Appointments" class="btn btn-light btn-sm mt-2">Go to Appointments</a>
                    </div>
                </div>
            </div>

            <!-- Doctors Card -->
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #3498db, #2980b9);">
                    <div class="card-body text-white text-center">
                        <i class="fas fa-user-md fa-3x mb-3"></i>
                        <h3 class="card-title">Doctors</h3>
                        <p class="card-text">Manage doctor profiles</p>
                        <a href="/Doctors" class="btn btn-light btn-sm mt-2">Go to Doctors</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm" style="background-color: #ecf0f1;">
                    <div class="card-body">
                        <h4 class="text-center" style="color: #2c3e50;">Today's Overview</h4>
                        <div class="row text-center">
                            <div class="col-md-4">
                                <h3 style="color: #3498db;">12</h3>
                                <p class="text-muted">Upcoming Appointments</p>
                            </div>
                            <div class="col-md-4">
                                <h3 style="color: #2ecc71;">8</h3>
                                <p class="text-muted">New Patients</p>
                            </div>
                            <div class="col-md-4">
                                <h3 style="color: #3498db;">5</h3>
                                <p class="text-muted">Available Doctors</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom CSS -->
<style>
    .card {
        transition: transform 0.3s ease;
        border-radius: 10px;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn-light {
        background-color: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
    }
</style>