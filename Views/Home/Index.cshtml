@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-semibold text-primary">
            <i class="fas fa-clinic-medical me-3"></i>MediTrackPro Clinical Dashboard
        </h1>
        <p class="lead text-muted">Comprehensive healthcare management overview</p>
    </div>

    <!-- Quick Access Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-effect">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-4 mb-4 mx-auto" style="width: 80px;">
                        <i class="fas fa-procedures text-primary fa-2x"></i>
                    </div>
                    <h3 class="text-primary mb-3">Patient Registry</h3>
                    <p class="text-muted mb-4">Manage comprehensive patient records and medical histories</p>
                    <a href="/Patients" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-right me-2"></i>Access Registry
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-effect">
                <div class="card-body text-center p-4">
                    <div class="bg-success bg-opacity-10 rounded-circle p-4 mb-4 mx-auto" style="width: 80px;">
                        <i class="fas fa-calendar-check text-success fa-2x"></i>
                    </div>
                    <h3 class="text-success mb-3">Appointment Scheduler</h3>
                    <p class="text-muted mb-4">Coordinate patient visits and physician availability</p>
                    <a href="/Appointments" class="btn btn-outline-success">
                        <i class="fas fa-arrow-right me-2"></i>View Schedule
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-effect">
                <div class="card-body text-center p-4">
                    <div class="bg-info bg-opacity-10 rounded-circle p-4 mb-4 mx-auto" style="width: 80px;">
                        <i class="fas fa-user-md text-info fa-2x"></i>
                    </div>
                    <h3 class="text-info mb-3">Doctor's Directory</h3>
                    <p class="text-muted mb-4">Manage medical staff and specialist information</p>
                    <a href="/Doctors" class="btn btn-outline-info">
                        <i class="fas fa-arrow-right me-2"></i>View Doctors
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Clinical Metrics -->
    <div class="card border-0 shadow mb-5">
        <div class="card-header bg-dark text-white py-3">
            <h3 class="mb-0">
                <i class="fas fa-chart-line me-2"></i>Today's Clinical Metrics
            </h3>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex flex-column align-items-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 mb-3">
                            <i class="fas fa-calendar-day text-primary fa-xl"></i>
                        </div>
                        <h2 class="text-primary mb-1">12</h2>
                        <p class="text-muted mb-0">Scheduled Consultations</p>
                    </div>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex flex-column align-items-center">
                        <div class="bg-success bg-opacity-10 rounded-circle p-3 mb-3">
                            <i class="fas fa-user-plus text-success fa-xl"></i>
                        </div>
                        <h2 class="text-success mb-1">8</h2>
                        <p class="text-muted mb-0">New Patient Registrations</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex flex-column align-items-center">
                        <div class="bg-info bg-opacity-10 rounded-circle p-3 mb-3">
                            <i class="fas fa-stethoscope text-info fa-xl"></i>
                        </div>
                        <h2 class="text-info mb-1">5</h2>
                        <p class="text-muted mb-0">Available Specialists</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-effect {
        transition: all 0.3s ease;
        border-radius: 8px;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .card-header {
        border-radius: 8px 8px 0 0 !important;
    }
</style>