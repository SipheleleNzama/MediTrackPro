@model MediTrackPro.Models.Appointment

@{
    ViewData["Title"] = "Schedule New Appointment";
}

<div class="form-container" style="background-color: #f5f9fc; min-height: 100vh; padding: 2rem 0;">
    <div class="container">
        <div class="card border-0 shadow-sm" style="max-width: 800px; margin: 0 auto;">
            <div class="card-header" style="background-color: #3498db; color: white;">
                <h2 class="mb-0"><i class="fas fa-calendar-plus me-2"></i>@ViewData["Title"]</h2>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PatientId" class="control-label">Patient</label>
                                <select asp-for="PatientId" class="form-control" asp-items="ViewBag.PatientId"></select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="DoctorId" class="control-label">Doctor</label>
                                <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId"></select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="DateTime" class="control-label">Date & Time</label>
                        <input asp-for="DateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="DateTime" class="text-danger"></span>
                    </div>

                    <div class="form-group text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Schedule Appointment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}