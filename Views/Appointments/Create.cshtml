@model MediTrackPro.Models.Appointment

@{
    ViewData["Title"] = "Schedule Clinical Appointment";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-header bg-dark text-white py-3">
                    <h3 class="mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" class="needs-validation" novalidate>
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PatientId" class="form-label fw-semibold">
                                    <i class="fas fa-user-injured me-2"></i>Patient
                                </label>
                                <select asp-for="PatientId" class="form-select" asp-items="ViewBag.PatientId" required>
                                    <option value="">Select patient...</option>
                                </select>
                                <span asp-validation-for="PatientId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DoctorId" class="form-label fw-semibold">
                                    <i class="fas fa-user-md me-2"></i>Physician
                                </label>
                                <select asp-for="DoctorId" class="form-select" asp-items="ViewBag.DoctorId" required>
                                    <option value="">Select physician...</option>
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DateTime" class="form-label fw-semibold">
                                <i class="fas fa-clock me-2"></i>Appointment Date & Time
                            </label>
                            <input asp-for="DateTime" class="form-control" type="datetime-local" required />
                            <span asp-validation-for="DateTime" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-sticky-note me-2"></i>Appointment Type
                            </label>
                            <select class="form-select">
                                <option>Initial Consultation</option>
                                <option>Follow-up Visit</option>
                                <option>Procedure</option>
                                <option>Emergency</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-chevron-left me-2"></i>Return to Schedule
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-calendar-check me-2"></i>Confirm Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Enhanced date/time picker
        document.addEventListener('DOMContentLoaded', function() {
            const dateTimeInput = document.querySelector('input[type="datetime-local"]');
            const now = new Date();
            const minDate = new Date(now.getTime() - (now.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
            dateTimeInput.min = minDate;
        });
    </script>
}