@model IEnumerable<MediTrackPro.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="appointments-container" style="background-color: #f5f9fc; min-height: 100vh; padding: 2rem 0;">
    <div class="container">
        <!-- Header with Stats -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 style="color: #2c3e50; font-weight: 600;">
                    <i class="fas fa-calendar-alt me-2" style="color: #3498db;"></i>@ViewData["Title"]
                </h1>
                <p class="text-muted">Manage patient appointments and schedules</p>
            </div>
            <div class="text-end">
                <a asp-action="Create" class="btn btn-primary" style="background-color: #3498db; border: none;">
                    <i class="fas fa-plus-circle me-1"></i> Schedule New
                </a>
            </div>
        </div> 
    </div>
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #e3f2fd, #bbdefb);">
                <div class="card-body text-center">
                    <h5 class="card-title" style="color: #0d47a1;">Today</h5>
                    <h2 style="color: #1976d2;">@Model.Count(a => a.DateTime.Date == DateTime.Today)</h2>
                </div>
            </div>
        </div>
 </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #e8f5e9, #c8e6c9);">
            <div class="card-body text-center">
                <h5 class="card-title" style="color: #1b5e20;">Upcoming</h5>
                <h2 style="color: #2e7d32;">@Model.Count(a => a.DateTime > DateTime.Now)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #fff3e0, #ffe0b2);">
            <div class="card-body text-center">
                <h5 class="card-title" style="color: #e65100;">Pending</h5>
                <h2 style="color: #fb8c00;">@Model.Count(a => a.Status == "Pending")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #fce4ec, #f8bbd0);">
            <div class="card-body text-center">
                <h5 class="card-title" style="color: #880e4f;">Cancelled</h5>
                <h2 style="color: #c2185b;">@Model.Count(a => a.Status == "Cancelled")</h2>
            </div>
        </div>
    </div>
</div>
<!-- Appointments Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background-color: #3498db; color: white;">
                    <tr>
                        <th><i class="far fa-clock me-1"></i> Date/Time</th>
                        <th><i class="fas fa-user-injured me-1"></i> Patient</th>
                        <th><i class="fas fa-user-md me-1"></i> Doctor</th>
                        <th><i class="fas fa-info-circle me-1"></i> Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="border-left: 4px solid @GetStatusColor(item.Status);">
                            <td>
                                <strong>@item.DateTime.ToString("MMM dd")</strong><br>
                                <small class="text-muted">@item.DateTime.ToString("h:mm tt")</small>
                            </td>
                            <td>
                                @item.Patient?.FirstName @item.Patient?.LastName<br>
                                <small class="text-muted">Patient ID: @item.Patient?.Id</small>
                            </td>
                            <td>
                                Dr. @item.Doctor?.LastName<br>
                                <small class="text-muted">@item.Doctor?.Specialty</small>
                            </td>
                            <td>
                                <span class="badge rounded-pill" style="background-color: @GetStatusColor(item.Status);">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<!-- Custom Styles -->
<style>
    .table-hover tbody tr:hover {
        background-color: rgba(52, 152, 219, 0.1);
    }

    .badge {
        padding: 0.35em 0.65em;
        font-size: 0.85em;
    }
</style>

@functions {
    string GetStatusColor(string status)
    {
        return status switch
        {
            "Completed" => "#2ecc71",
            "Pending" => "#f39c12",
            "Cancelled" => "#e74c3c",
            "Confirmed" => "#3498db",
            _ => "#95a5a6"
        };
    }
}
