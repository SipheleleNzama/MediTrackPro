@model IEnumerable<MediTrackPro.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediTrackPro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="container py-4">
        <!-- Calendar Section -->
        <div class="mb-4 position-relative">
            <div id="calendarLoading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <div id="calendar" class="border rounded-3 p-3 bg-white"></div>
        </div>

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-semibold text-primary">
                    <i class="fas fa-calendar-check me-2"></i>@ViewData["Title"]
                </h1>
                <p class="lead text-muted">Manage patient consultations and visits</p>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-calendar-plus me-2"></i>Schedule Appointment
                </a>
            </div>
        </div>

        <!-- Metrics Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card">
                    <div class="card-body text-center py-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                            <i class="fas fa-calendar-day text-primary fs-4"></i>
                        </div>
                        <h5 class="text-muted mb-2">Today's</h5>
                        <h2 class="text-primary">@Model.Count(a => a.DateTime.Date == DateTime.Today)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card">
                    <div class="card-body text-center py-4">
                        <div class="bg-success bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                            <i class="fas fa-calendar-week text-success fs-4"></i>
                        </div>
                        <h5 class="text-muted mb-2">Upcoming</h5>
                        <h2 class="text-success">@Model.Count(a => a.DateTime > DateTime.Now)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card">
                    <div class="card-body text-center py-4">
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                            <i class="fas fa-hourglass-half text-warning fs-4"></i>
                        </div>
                        <h5 class="text-muted mb-2">Pending</h5>
                        <h2 class="text-warning">@Model.Count(a => a.Status == "Pending")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 dashboard-card">
                    <div class="card-body text-center py-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 60px;">
                            <i class="fas fa-calendar-times text-danger fs-4"></i>
                        </div>
                        <h5 class="text-muted mb-2">Cancelled</h5>
                        <h2 class="text-danger">@Model.Count(a => a.Status == "Cancelled")</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs mb-4" id="appointmentTabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#all">All Appointments</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#upcoming">Upcoming</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#completed">Completed</a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <div class="tab-pane fade show active" id="all">
                <div class="card border-0 shadow">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-dark text-white">
                                    <tr>
                                        <th><i class="fas fa-clock me-2"></i>Date/Time</th>
                                        <th><i class="fas fa-user-injured me-2"></i>Patient</th>
                                        <th><i class="fas fa-user-md me-2"></i>Physician</th>
                                        <th><i class="fas fa-info-circle me-2"></i>Status</th>
                                        <th class="text-end"><i class="fas fa-ellipsis-h me-2"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="py-3 @(item.DateTime < DateTime.Now ? "past-due" : item.DateTime < DateTime.Now.AddHours(24) ? "urgent" : "")">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold">@item.DateTime.ToString("MMM dd, yyyy")</span>
                                                    <small class="text-muted">@item.DateTime.ToString("h:mm tt")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fas fa-user text-info"></i>
                                                    </div>
                                                    <div>
                                                        <span class="d-block">@item.Patient?.FirstName @item.Patient?.LastName</span>
                                                        <small class="text-muted">ID: @item.Patient?.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fas fa-user-md text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <span class="d-block">Dr. @item.Doctor?.LastName</span>
                                                        <small class="text-muted">@item.Doctor?.Specialty</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge py-2 px-3 @GetStatusClass(item.Status)">
                                                    <i class="@GetStatusIcon(item.Status) me-1"></i>@item.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button" data-bs-toggle="dropdown">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                                                <i class="fas fa-edit me-2"></i>Edit
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                                                <i class="fas fa-file-alt me-2"></i>Details
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item text-danger" href="#cancelModal"
                                                               data-bs-toggle="modal" data-id="@item.Id">
                                                                <i class="fas fa-times-circle me-2"></i>Cancel
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="upcoming">
                <div class="card border-0 shadow">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-dark text-white">
                                    <tr>
                                        <th><i class="fas fa-clock me-2"></i>Date/Time</th>
                                        <th><i class="fas fa-user-injured me-2"></i>Patient</th>
                                        <th><i class="fas fa-user-md me-2"></i>Physician</th>
                                        <th><i class="fas fa-info-circle me-2"></i>Status</th>
                                        <th class="text-end"><i class="fas fa-ellipsis-h me-2"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(a => a.DateTime > DateTime.Now))
                                    {
                                        <tr class="py-3 @(item.DateTime < DateTime.Now.AddHours(24) ? "urgent" : "")">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold">@item.DateTime.ToString("MMM dd, yyyy")</span>
                                                    <small class="text-muted">@item.DateTime.ToString("h:mm tt")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fas fa-user text-info"></i>
                                                    </div>
                                                    <div>
                                                        <span class="d-block">@item.Patient?.FirstName @item.Patient?.LastName</span>
                                                        <small class="text-muted">ID: @item.Patient?.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fas fa-user-md text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <span class="d-block">Dr. @item.Doctor?.LastName</span>
                                                        <small class="text-muted">@item.Doctor?.Specialty</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge py-2 px-3 @GetStatusClass(item.Status)">
                                                    <i class="@GetStatusIcon(item.Status) me-1"></i>@item.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button" data-bs-toggle="dropdown">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                                                <i class="fas fa-edit me-2"></i>Edit
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                                                <i class="fas fa-file-alt me-2"></i>Details
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item text-danger" href="#cancelModal"
                                                               data-bs-toggle="modal" data-id="@item.Id">
                                                                <i class="fas fa-times-circle me-2"></i>Cancel
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="completed">
                <div class="card border-0 shadow">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-dark text-white">
                                    <tr>
                                        <th><i class="fas fa-clock me-2"></i>Date/Time</th>
                                        <th><i class="fas fa-user-injured me-2"></i>Patient</th>
                                        <th><i class="fas fa-user-md me-2"></i>Physician</th>
                                        <th><i class="fas fa-info-circle me-2"></i>Status</th>
                                        <th class="text-end"><i class="fas fa-ellipsis-h me-2"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(a => a.Status == "Completed"))
                                    {
                                        <tr class="py-3">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold">@item.DateTime.ToString("MMM dd, yyyy")</span>
                                                    <small class="text-muted">@item.DateTime.ToString("h:mm tt")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fas fa-user text-info"></i>
                                                    </div>
                                                    <div>
                                                        <span class="d-block">@item.Patient?.FirstName @item.Patient?.LastName</span>
                                                        <small class="text-muted">ID: @item.Patient?.Id</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                        <i class="fas fa-user-md text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <span class="d-block">Dr. @item.Doctor?.LastName</span>
                                                        <small class="text-muted">@item.Doctor?.Specialty</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge py-2 px-3 @GetStatusClass(item.Status)">
                                                    <i class="@GetStatusIcon(item.Status) me-1"></i>@item.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button" data-bs-toggle="dropdown">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                                                <i class="fas fa-file-alt me-2"></i>Details
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item" asp-action="Create" asp-controller="VisitRecords" asp-route-appointmentId="@item.Id">
                                                                <i class="fas fa-notes-medical me-2"></i>Create Visit Note
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Appointment Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Cancel Appointment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel this appointment?</p>
                    <form id="cancelForm" method="post">
                        <input type="hidden" id="cancelAppointmentId" name="id" value="">
                        <div class="mb-3">
                            <label for="cancelReason" class="form-label">Reason for cancellation:</label>
                            <textarea class="form-control" id="cancelReason" name="cancelReason" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" form="cancelForm" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.js"></script>
    <script>
        // Initialize FullCalendar
        document.addEventListener('DOMContentLoaded', function() {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                loading: function(isLoading) {
                    document.getElementById('calendarLoading').style.display =
                        isLoading ? 'block' : 'none';
                },
                eventClick: function(info) {
                    window.location.href = info.event.url;
                },
                dateClick: function(info) {
                    window.location.href = `@Url.Action("Create")?date=${info.dateStr}`;
                }
            });
            calendar.render();
        });

        // Initialize Bootstrap tabs
        document.addEventListener('DOMContentLoaded', function() {
            const tabEls = document.querySelectorAll('#appointmentTabs a[data-bs-toggle="tab"]');
            tabEls.forEach(function(tabEl) {
                tabEl.addEventListener('shown.bs.tab', function (event) {
                    localStorage.setItem('lastTab', event.target.getAttribute('href'));
                });
            });

            const lastTab = localStorage.getItem('lastTab');
            if (lastTab) {
                const tab = new bootstrap.Tab(document.querySelector(`#appointmentTabs a[href="${lastTab}"]`));
                tab.show();
            }
        });

        // Cancel modal handling
        document.addEventListener('DOMContentLoaded', function() {
            const cancelModal = document.getElementById('cancelModal');
            if (cancelModal) {
                cancelModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const appointmentId = button.getAttribute('data-id');
                    document.getElementById('cancelAppointmentId').value = appointmentId;
                });
            }
        });
    </script>
</body>
</html>

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success bg-opacity-10 text-success",
            "Pending" => "bg-warning bg-opacity-10 text-warning pulse-animation",
            "Cancelled" => "bg-danger bg-opacity-10 text-danger",
            "Confirmed" => "bg-primary bg-opacity-10 text-primary",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Completed" => "fas fa-check-circle",
            "Pending" => "fas fa-hourglass-half",
            "Cancelled" => "fas fa-times-circle",
            "Confirmed" => "fas fa-calendar-check",
            _ => "fas fa-info-circle"
        };
    }
}